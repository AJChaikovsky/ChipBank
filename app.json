{
  "expo": {
    "name": "ChipBank",
    "slug": "chipbank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ajchaikovsky.chipbank",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ajchaikovsky.chipbank"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "ChipBank",
      "description": "Track buy-ins, cash-outs, and who owes whom at your home poker game."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "scheme": "chipbank",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ajchaikovsky",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5b421dc7-cf0c-4acf-8af2-985bb9255ae3"
      }
    }
  }
}
